# -----------------------------------------------------------------------------
# Wedding Gift Tracking Web Application (ប្រព័ន្ធកត់ចំណងដៃអាពាហ៍ពិពាហ៍)
# Environment Configuration
# -----------------------------------------------------------------------------

# Supabase Project URL & Anon Key (Found in Supabase Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Service Role key for administrative scripts (Keep secret, never expose on client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Wedding Exchange Rate (1 USD = ~4,100 KHR)
NEXT_PUBLIC_USD_TO_KHR_RATE=4100

# Default Wedding Titles (Customizable for bride & groom)
NEXT_PUBLIC_GROOM_NAME=ពិសិដ្ឋ (Piseth)
NEXT_PUBLIC_BRIDE_NAME=ធីតា (Thida)
NEXT_PUBLIC_WEDDING_DATE=2026-11-28
